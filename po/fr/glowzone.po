#, kde-format
msgid "Could not initialise HID access: %1"
msgstr "Impossible d’initialiser l’accès HID : %1"

#: src/core/fancontroller.cpp
#, kde-format
msgid "Fan LED controller %1 not found or not accessible (%2)."
msgstr "Contrôleur de LED des ventilateurs %1 introuvable ou inaccessible (%2)."

#: src/core/fancontroller.cpp
#, kde-format
msgid "Sending to the fan LED controller failed: %1"
msgstr "Échec de l’envoi au contrôleur de LED des ventilateurs : %1"

