#: src/core/eclights.cpp:194
#, kde-format
msgid "This is a BIOS detection glitch that can happen after a cold start, when a fan isn’t spinning yet. The fan LEDs usually still work, and your settings are unchanged. A reboot normally clears it."
msgstr "Il s’agit d’un défaut de détection du BIOS qui peut survenir après un démarrage à froid, lorsqu’un ventilateur ne tourne pas encore. Les LED des ventilateurs fonctionnent généralement quand même, et vos réglages restent inchangés. Un redémarrage règle normalement le problème."

#: src/core/eclights.cpp:198
#, kde-format
msgctxt "%1 fan names, %2 and %3 layout codes, %4 explanation"
msgid ""
"The BIOS doesn’t detect these fans right now: %1 (fan layout %2, normally %3).\n"
"%4"
msgstr ""
"Le BIOS ne détecte pas ces ventilateurs pour le moment : %1 (disposition %2, normalement %3).\n"
"%4"

#: src/core/eclights.cpp:205
#, kde-format
msgctxt "%1 and %2 layout codes, %3 explanation"
msgid ""
"The BIOS reports an unusual fan layout right now (%1, normally %2); a fan may not be detected.\n"
"%3"
msgstr ""
"Le BIOS signale actuellement une disposition de ventilateurs inhabituelle (%1, normalement %2) ; un ventilateur n’est peut-être pas détecté.\n"
"%3"

