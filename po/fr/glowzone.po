msgstr "Impossible d’enregistrer l’état des ventilateurs dans %1 : %2"

#: src/core/helpercall.cpp
#, kde-format
msgid "The helper refused to run: this computer is not a supported model."
msgstr "Le programme d’assistance refuse de s’exécuter : cet ordinateur n’est pas un modèle pris en charge."

#: src/core/helpercall.cpp
#, kde-format
msgid "The acpi_call kernel module is not available. Install acpi_call-dkms (or acpi_call / acpi_call-lts for your kernel)."
msgstr "Le module noyau acpi_call n’est pas disponible. Installez acpi_call-dkms (ou acpi_call / acpi_call-lts selon votre noyau)."

#: src/core/helpercall.cpp
#, kde-format
msgid "The BIOS does not report the case lights on this computer."
msgstr "Le BIOS ne signale pas d’éclairage du boîtier sur cet ordinateur."

#: src/core/helpercall.cpp
#, kde-format
msgid "The helper rejected the request as invalid."
msgstr "Le programme d’assistance a rejeté la requête comme invalide."

#: src/core/helpercall.cpp
#, kde-format
msgid "The firmware call for the case lights failed."
msgstr "L’appel au micrologiciel pour l’éclairage du boîtier a échoué."

#: src/core/helpercall.cpp
#, kde-format
msgid "Not authorised to change the case lights."
msgstr "Vous n’êtes pas autorisé à modifier l’éclairage du boîtier."

#: src/core/helpercall.cpp
#, kde-format
msgid "Authorisation was cancelled."
msgstr "L’autorisation a été annulée."

#: src/core/helpercall.cpp
#, kde-format
msgid "The authorisation system (polkit) reported an error."
msgstr "Le système d’autorisation (polkit) a signalé une erreur."

#: src/core/helpercall.cpp
#, kde-format
msgid "Could not reach the Glowzone helper. Is Glowzone installed correctly?"
msgstr "Impossible de joindre le programme d’assistance de Glowzone. Glowzone est-il correctement installé ?"

#: src/core/helpercall.cpp
#, kde-format
msgid "The Glowzone helper reported an error (code %1)."
msgstr "Le programme d’assistance de Glowzone a signalé une erreur (code %1)."

#: src/core/helpercall.cpp
#, kde-format
msgctxt "@info technical details follow"
msgid "Details: %1"
msgstr "Détails : %1"

#: src/core/helpercall.cpp
#, kde-format
msgid "The Glowzone helper didn’t answer. Try again in a moment."
msgstr "Le programme d’assistance de Glowzone n’a pas répondu. Réessayez dans un instant."

#: src/core/helpercall.cpp
#, kde-format
msgid "Another Glowzone window or command is using the case lights. Try again in a moment."
msgstr "Une autre fenêtre ou commande Glowzone utilise l’éclairage du boîtier. Réessayez dans un instant."

