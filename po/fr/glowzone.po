#: src/cli/commands.cpp
#, kde-format
msgid "Fan speed, brightness:"
msgstr "Vitesse, luminosité des ventilateurs :"

#: src/cli/commands.cpp
#, kde-format
msgid "Temperature range (--range):"
msgstr "Plage de températures (--range) :"

#: src/cli/commands.cpp
#, kde-format
msgid "%1 to %2 °C, at least %3 apart (default %4-%5)"
msgstr "%1 à %2 °C, écart d’au moins %3 (par défaut %4-%5)"

#: src/cli/commands.cpp
#, kde-format
msgid "Light modes:"
msgstr "Modes d’éclairage :"

#: src/cli/commands.cpp
#, kde-format
msgid "Light brightness:"
msgstr "Luminosité de l’éclairage :"

#: src/cli/commands.cpp
#, kde-format
msgid "This computer is not supported. Supported models: %1"
msgstr "Cet ordinateur n’est pas pris en charge. Modèles pris en charge : %1"

#: src/cli/commands.cpp
#, kde-format
msgid "status, fan, light, reset or profile"
msgstr "status, fan, light, reset ou profile"

#: src/cli/commands.cpp
#, kde-format
msgid "Arguments of the command"
msgstr "Arguments de la commande"

#: src/cli/commands.cpp
#, kde-format
msgid "Unknown command “%1”."
msgstr "Commande « %1 » inconnue."

#: src/cli/commands.cpp
#, kde-format
msgid "“status” takes no arguments."
msgstr "« status » n’accepte aucun argument."

#: src/cli/commands.cpp
#, kde-format
msgid "“reset” takes no arguments."
msgstr "« reset » n’accepte aucun argument."

