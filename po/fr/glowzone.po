#, kde-format
msgid "Could not create the directory for %1."
msgstr "Impossible de créer le répertoire pour %1."

#: src/core/fanstate.cpp
#, kde-format
msgid "%1 is damaged and could not be moved aside to %2."
msgstr "%1 est endommagé et n’a pas pu être mis de côté sous %2."

#: src/core/fanstate.cpp
#, kde-format
msgid "%1 was saved by a newer version of Glowzone and is left as it is."
msgstr "%1 a été enregistré par une version plus récente de Glowzone et reste tel quel."

#: src/core/fanstate.cpp src/core/profiles.cpp
#, kde-format
msgid "Could not read %1: %2"
msgstr "Impossible de lire %1 : %2"

#: src/core/fanstate.cpp
