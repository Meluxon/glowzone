#: src/cli/commands.cpp
#, kde-format
msgid "Fan colour as RRGGBB, for modes that use a colour."
msgstr "Couleur des ventilateurs en RRGGBB, pour les modes qui utilisent une couleur."

#: src/cli/commands.cpp
#, kde-format
msgid "Fan effect speed (levels: see below)."
msgstr "Vitesse de l’effet des ventilateurs (niveaux : voir ci-dessous)."

#: src/cli/commands.cpp
#, kde-format
msgid "Brightness of fans or case lights (levels: see below)."
msgstr "Luminosité des ventilateurs ou de l’éclairage du boîtier (niveaux : voir ci-dessous)."

#: src/cli/commands.cpp
#, kde-format
msgid "Set only one LED of a double fan (positions: see below)."
msgstr "Ne régler qu’une LED d’un ventilateur double (positions : voir ci-dessous)."

#: src/cli/commands.cpp
#, kde-format
msgid "With cpu-temperature: the temperatures the colours are spread over, e.g. 35-80. Shared by all fans in that mode."
msgstr "Avec cpu-temperature : la plage de températures sur laquelle les couleurs sont réparties, p. ex. 35-80. Commune à tous les ventilateurs dans ce mode."

#: src/cli/commands.cpp
#, kde-format
msgid "Delete Glowzone's settings, profiles and saved state for this user, then exit."
msgstr "Supprimer les paramètres, les profils et l’état enregistré de Glowzone pour cet utilisateur, puis quitter."

#: src/cli/commands.cpp
#, kde-format
msgid "Run “glowzone --help” for usage."
msgstr "Lancez « glowzone --help » pour l’aide."

#: src/cli/commands.cpp
#, kde-format
msgid "“%1” must be a number from %2 to %3."
msgstr "« %1 » doit être un nombre de %2 à %3."

#: src/cli/commands.cpp
#, kde-format
msgctxt "@info fan effect speed"
msgid "speed %1"
msgstr "vitesse %1"

#: src/cli/commands.cpp
#, kde-format
msgctxt "@info"
msgid "brightness %1"
msgstr "luminosité %1"

#: src/cli/commands.cpp
#, kde-format
msgctxt "@info unknown mode value"
msgid "mode %1"
msgstr "mode %1"

#: src/cli/commands.cpp
#, kde-format
msgctxt "@info light mode, brightness"
msgid "%1, brightness %2"
msgstr "%1, luminosité %2"

#: src/cli/commands.cpp
#, kde-format
msgid "Note: LEDs following the CPU temperature only change colour while Glowzone is running (the window, or in the background). Start it with “glowzone” or “glowzone --background”."
msgstr "Remarque : les LED qui suivent la température du processeur ne changent de couleur que lorsque Glowzone est en cours d’exécution (la fenêtre, ou en arrière-plan). Lancez-le avec « glowzone » ou « glowzone --background »."

#: src/cli/commands.cpp
#, kde-format
msgid "“%1” is not a usable range. Give two whole numbers of °C from %2 to %3, at least %4 apart, e.g. 35-80."
msgstr "« %1 » n’est pas une plage utilisable. Indiquez deux nombres entiers de °C entre %2 et %3, écartés d’au moins %4, p. ex. 35-80."

#: src/cli/commands.cpp
#, kde-format
msgid "unknown (not set by Glowzone yet)"
msgstr "inconnu (pas encore réglé par Glowzone)"

#: src/cli/commands.cpp
#, kde-format
msgctxt "@info fan position: description"
msgid "%1: %2"
msgstr "%1 : %2"

#: src/cli/commands.cpp
#, kde-format
msgid "Computer: %1"
msgstr "Ordinateur : %1"

#: src/cli/commands.cpp
#, kde-format
msgid "Fans (as last set by Glowzone – the controller can’t be read back):"
msgstr "Ventilateurs (tels que Glowzone les a réglés en dernier – le contrôleur ne peut pas être relu) :"

#: src/cli/commands.cpp
#, kde-format
msgid "the colours follow it"
msgstr "les couleurs la suivent"

#: src/cli/commands.cpp
#, kde-format
msgid "not followed – Glowzone isn’t running"
msgstr "non suivie – Glowzone n’est pas lancé"

#: src/cli/commands.cpp
#, kde-format
msgid "CPU temperature: %1 °C, colours over %2–%3 °C (%4)"
msgstr "Température du processeur : %1 °C, couleurs sur %2–%3 °C (%4)"

#: src/cli/commands.cpp
#, kde-format
msgid "Lights:"
msgstr "Éclairage :"

#: src/cli/commands.cpp
#, kde-format
msgid "not available: %1"
msgstr "non disponible : %1"

#: src/cli/commands.cpp
#, kde-format
msgctxt "@info"
msgid "all fans detected (layout %1)"
msgstr "tous les ventilateurs détectés (disposition %1)"

#: src/cli/commands.cpp
#, kde-format
msgid "Fan detection (BIOS): %1"
msgstr "Détection des ventilateurs (BIOS) : %1"

#: src/cli/commands.cpp
#, kde-format
msgid "Usage: glowzone fan <fan> <mode> [-c RRGGBB] [-s speed] [-b brightness] [-l position] [-r coolest-hottest]"
msgstr "Utilisation : glowzone fan <ventilateur> <mode> [-c RRGGBB] [-s vitesse] [-b luminosité] [-l position] [-r min-max]"

#: src/cli/commands.cpp
#, kde-format
msgid "Unknown fan “%1”. Choose one of: %2"
msgstr "Ventilateur « %1 » inconnu. Choisissez parmi : %2"

#: src/cli/commands.cpp
#, kde-format
msgid "Unknown fan mode “%1”. Choose one of: %2"
msgstr "Mode de ventilateur « %1 » inconnu. Choisissez parmi : %2"

#: src/cli/commands.cpp
#, kde-format
msgid "“%1” is not a colour. Use six hex digits, e.g. ff3d9c."
msgstr "« %1 » n’est pas une couleur. Indiquez six chiffres hexadécimaux, par ex. ff3d9c."

#: src/cli/commands.cpp
#, kde-format
msgid "--range only works with the mode %1."
msgstr "--range ne fonctionne qu’avec le mode %1."

#: src/cli/commands.cpp
#, kde-format
msgid "--led only works with a single fan that has more than one LED."
msgstr "--led ne fonctionne qu’avec un seul ventilateur doté de plusieurs LED."

#: src/cli/commands.cpp
#, kde-format
msgid "Unknown position “%1”. Choose one of: %2"
msgstr "Position « %1 » inconnue. Choisissez parmi : %2"

#: src/cli/commands.cpp
#, kde-format
msgid "The fans were changed, but the state could not be saved: %1"
msgstr "Les ventilateurs ont été modifiés, mais l’état n’a pas pu être enregistré : %1"

#: src/cli/commands.cpp
#, kde-format
msgctxt "@item fan (position)"
msgid "%1 (%2)"
msgstr "%1 (%2)"

#: src/cli/commands.cpp
#, kde-format
msgid "Usage: glowzone light <light> [mode] [-b brightness]"
msgstr "Utilisation : glowzone light <lumière> [mode] [-b luminosité]"

#: src/cli/commands.cpp
#, kde-format
msgid "Unknown light “%1”. Choose one of: %2"
msgstr "Lumière « %1 » inconnue. Choisissez parmi : %2"

#: src/cli/commands.cpp
#, kde-format
msgid "Unknown light mode “%1”. Choose one of: %2"
msgstr "Mode d’éclairage « %1 » inconnu. Choisissez parmi : %2"

#: src/cli/commands.cpp
#, kde-format
msgid "Give a mode, a brightness (-b), or both."
msgstr "Indiquez un mode, une luminosité (-b), ou les deux."

#: src/cli/commands.cpp
#, kde-format
msgid "Fans: all off."
msgstr "Ventilateurs : tous éteints."

#: src/cli/commands.cpp
#, kde-format
msgid "Fans: %1"
msgstr "Ventilateurs : %1"

#: src/cli/commands.cpp
#, kde-format
msgid "Case lights: off."
msgstr "Éclairage du boîtier : éteint."

#: src/cli/commands.cpp
#, kde-format
msgid "Case lights: %1"
msgstr "Éclairage du boîtier : %1"

#: src/cli/commands.cpp
#, kde-format
msgid "Usage: glowzone profile list | apply <name> | save <name> | rename <old> <new> | delete <name>"
msgstr "Utilisation : glowzone profile list | apply <nom> | save <nom> | rename <ancien> <nouveau> | delete <nom>"

#: src/cli/commands.cpp
#, kde-format
msgid "No profiles saved yet. Save one with “glowzone profile save <name>”."
msgstr "Aucun profil enregistré pour l’instant. Enregistrez-en un avec « glowzone profile save <nom> »."

#: src/cli/commands.cpp src/core/profiles.cpp
#, kde-format
msgid "There is no profile called “%1”."
msgstr "Il n’existe aucun profil nommé « %1 »."

#: src/cli/commands.cpp
#, kde-format
msgid "Applied profile “%1”."
msgstr "Profil « %1 » appliqué."

#: src/cli/commands.cpp src/core/profiles.cpp src/gui/mainwindow.cpp
#, kde-format
msgid "A profile name must be 1 to %1 characters long."
msgstr "Un nom de profil doit comporter de 1 à %1 caractères."

#: src/cli/commands.cpp
#, kde-format
msgid "Note: Glowzone hasn’t set any fan yet, so the profile contains no fan settings."
msgstr "Remarque : Glowzone n’a encore réglé aucun ventilateur, le profil ne contient donc aucun réglage de ventilateur."

#: src/cli/commands.cpp
#, kde-format
msgid "Note: the case lights could not be read and are not part of the profile: %1"
msgstr "Remarque : l’éclairage du boîtier n’a pas pu être lu et ne fait pas partie du profil : %1"

#: src/cli/commands.cpp
#, kde-format
msgid "Saved profile “%1”."
msgstr "Profil « %1 » enregistré."

#: src/cli/commands.cpp
#, kde-format
msgid "Deleted profile “%1”."
msgstr "Profil « %1 » supprimé."

#: src/cli/commands.cpp
#, kde-format
msgid "Renamed profile “%1” to “%2”."
msgstr "Profil « %1 » renommé en « %2 »."

#: src/cli/commands.cpp
#, kde-format
msgid "Glowzone is running (the window or in the system tray). Quit it first."
msgstr "Glowzone est en cours d’exécution (la fenêtre ou dans la zone de notification). Quittez-le d’abord."

#: src/cli/commands.cpp
#, kde-format
msgid "Skipping %1: not a Glowzone directory."
msgstr "%1 ignoré : ce n’est pas un répertoire de Glowzone."

#: src/cli/commands.cpp
#, kde-format
msgid "Removed %1"
msgstr "%1 supprimé"

#: src/cli/commands.cpp
#, kde-format
msgid "Could not remove %1"
msgstr "Impossible de supprimer %1"

#: src/cli/commands.cpp
#, kde-format
msgid "No Glowzone user data found."
msgstr "Aucune donnée utilisateur de Glowzone trouvée."

#: src/cli/commands.cpp src/cli/main.cpp
#, kde-format
msgid "Lighting control for supported Lenovo desktops: fan LEDs and case lights."
msgstr "Contrôle de l’éclairage des ordinateurs de bureau Lenovo pris en charge : LED des ventilateurs et éclairage du boîtier."

#: src/cli/commands.cpp
#, kde-format
msgid "Commands:"
msgstr "Commandes :"

#: src/cli/commands.cpp
#, kde-format
msgid "Show the current lighting"
msgstr "Afficher l’éclairage actuel"

#: src/cli/commands.cpp
#, kde-format
msgid "Set fan LEDs"
msgstr "Régler les LED des ventilateurs"

#: src/cli/commands.cpp
#, kde-format
msgid "Set a case light"
msgstr "Régler un éclairage du boîtier"

#: src/cli/commands.cpp
#, kde-format
msgid "Turn all lighting off"
msgstr "Éteindre tout l’éclairage"

#: src/cli/commands.cpp
#, kde-format
msgid "List saved profiles (* = applied last)"
msgstr "Lister les profils enregistrés (* = appliqué en dernier)"

#: src/cli/commands.cpp
#, kde-format
msgid "Apply a profile"
msgstr "Appliquer un profil"

#: src/cli/commands.cpp
#, kde-format
msgid "Save the current lighting as a profile"
msgstr "Enregistrer l’éclairage actuel comme profil"

#: src/cli/commands.cpp
#, kde-format
msgid "Rename a profile"
msgstr "Renommer un profil"

#: src/cli/commands.cpp
#, kde-format
msgid "Delete a profile"
msgstr "Supprimer un profil"

#: src/cli/commands.cpp
#, kde-format
msgid "Run glowzone without arguments to open the window, or with --background to start in the system tray."
msgstr "Lancez glowzone sans argument pour ouvrir la fenêtre, ou avec --background pour le démarrer dans la zone de notification."

#: src/cli/commands.cpp
#, kde-format
msgid "This computer (%1):"
msgstr "Cet ordinateur (%1) :"

#: src/cli/commands.cpp
#, kde-format
msgid "Fans:"
msgstr "Ventilateurs :"

#: src/cli/commands.cpp
#, kde-format
msgid "LEDs (--led):"
msgstr "LED (--led) :"

#: src/cli/commands.cpp
#, kde-format
