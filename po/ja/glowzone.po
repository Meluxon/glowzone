msgstr "© 2026 Meluxon"

#: src/core/cputemperature.cpp
#, kde-format
msgid "The CPU sensor “%1” of %2 was not found."
msgstr "%2 の CPU センサー「%1」が見つかりません。"

#: src/core/cputemperature.cpp
#, kde-format
msgid "The CPU temperature sensor (%1) was not found. Is its kernel module loaded?"
msgstr "CPU 温度センサー（%1）が見つかりません。カーネルモジュールは読み込まれていますか？"

#: src/core/cputemperature.cpp
#, kde-format
msgid "The CPU temperature could not be read from %1."
msgstr "%1 から CPU 温度を読み取れませんでした。"

#: src/core/eclights.cpp
msgctxt "@item light mode"
msgid "Off"
msgstr "オフ"

#: src/core/eclights.cpp
msgctxt "@item light mode"
msgid "On"
msgstr "オン"

#: src/core/eclights.cpp
msgctxt "@item light mode"
msgid "Blink fast"
msgstr "高速点滅"

#: src/core/eclights.cpp
msgctxt "@item light mode"
msgid "Blink slow"
msgstr "低速点滅"

#: src/core/eclights.cpp
msgctxt "@item light mode"
msgid "Breathing"
msgstr "呼吸"

#: src/core/eclights.cpp
#, kde-format
msgid "This is a BIOS detection glitch that can happen after a cold start, when a fan isn’t spinning yet. The fan LEDs usually still work, and your settings are unchanged. A reboot normally clears it."
msgstr "これはコールドスタート後、ファンがまだ回転していないときに起こることがある BIOS の検出不具合です。通常、ファン LED はそのまま動作し、設定も変更されません。再起動すれば通常は解消します。"

#: src/core/eclights.cpp
#, kde-format
msgctxt "%1 fan names, %2 and %3 layout codes, %4 explanation"
msgid ""
"The BIOS doesn’t detect these fans right now: %1 (fan layout %2, normally %3).\n"
"%4"
msgstr ""
"現在、BIOS が次のファンを検出していません：%1（ファンレイアウト %2、通常は %3）。\n"
"%4"

#: src/core/eclights.cpp
#, kde-format
msgctxt "%1 and %2 layout codes, %3 explanation"
msgid ""
"The BIOS reports an unusual fan layout right now (%1, normally %2); a fan may not be detected.\n"
"%3"
msgstr ""
"現在、BIOS が通常と異なるファンレイアウト（%1、通常は %2）を報告しています。検出されていないファンがある可能性があります。\n"
"%3"

#: src/core/fancontroller.cpp
#, kde-format
msgid "Could not initialise HID access: %1"
msgstr "HID アクセスを初期化できませんでした：%1"

#: src/core/fancontroller.cpp
#, kde-format
msgid "Fan LED controller %1 not found or not accessible (%2)."
msgstr "ファン LED コントローラー %1 が見つからないか、アクセスできません（%2）。"

#: src/core/fancontroller.cpp
#, kde-format
msgid "Sending to the fan LED controller failed: %1"
msgstr "ファン LED コントローラーへの送信に失敗しました：%1"

#: src/core/fanstate.cpp src/core/settings.cpp
#, kde-format
msgid "Could not create the directory for %1."
msgstr "%1 用のディレクトリを作成できませんでした。"

#: src/core/fanstate.cpp
#, kde-format
msgid "%1 was saved by a newer version of Glowzone and is left as it is."
msgstr "%1 は新しいバージョンの Glowzone で保存されたため、変更しません。"

#: src/core/fanstate.cpp
#, kde-format
msgid "Could not save the fan state to %1: %2"
msgstr "ファンの状態を %1 に保存できませんでした：%2"

#: src/core/helpercall.cpp
#, kde-format
msgid "The helper refused to run: this computer is not a supported model."
msgstr "ヘルパーの実行が拒否されました：このコンピューターは対応機種ではありません。"

#: src/core/helpercall.cpp
#, kde-format
msgid "The acpi_call kernel module is not available. Install acpi_call-dkms (or acpi_call / acpi_call-lts for your kernel)."
msgstr "カーネルモジュール acpi_call が利用できません。acpi_call-dkms（またはお使いのカーネルに合わせて acpi_call / acpi_call-lts）をインストールしてください。"

#: src/core/helpercall.cpp
#, kde-format
msgid "The BIOS does not report the case lights on this computer."
msgstr "このコンピューターの BIOS はケースライトを報告していません。"

#: src/core/helpercall.cpp
#, kde-format
msgid "The helper rejected the request as invalid."
msgstr "ヘルパーは要求を無効として拒否しました。"

#: src/core/helpercall.cpp
#, kde-format
msgid "The firmware call for the case lights failed."
msgstr "ケースライトのファームウェア呼び出しに失敗しました。"

#: src/core/helpercall.cpp
#, kde-format
msgid "Not authorised to change the case lights."
msgstr "ケースライトを変更する権限がありません。"

#: src/core/helpercall.cpp
#, kde-format
msgid "Authorisation was cancelled."
msgstr "認証がキャンセルされました。"

#: src/core/helpercall.cpp
#, kde-format
msgid "The authorisation system (polkit) reported an error."
msgstr "認証システム（polkit）がエラーを報告しました。"

#: src/core/helpercall.cpp
#, kde-format
msgid "Could not reach the Glowzone helper. Is Glowzone installed correctly?"
msgstr "Glowzone のヘルパーに接続できません。Glowzone は正しくインストールされていますか？"

#: src/core/helpercall.cpp
#, kde-format
msgid "The Glowzone helper reported an error (code %1)."
msgstr "Glowzone のヘルパーがエラーを報告しました（コード %1）。"

#: src/core/helpercall.cpp
#, kde-format
msgctxt "@info technical details follow"
msgid "Details: %1"
msgstr "詳細：%1"

#: src/core/helpercall.cpp
#, kde-format
msgid "The Glowzone helper didn’t answer. Try again in a moment."
msgstr "Glowzone のヘルパーが応答しませんでした。しばらくしてからもう一度お試しください。"

#: src/core/helpercall.cpp
#, kde-format
msgid "Another Glowzone window or command is using the case lights. Try again in a moment."
msgstr "別の Glowzone ウィンドウまたはコマンドがケースライトを使用中です。しばらくしてからもう一度お試しください。"

