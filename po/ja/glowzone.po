msgid "%1 (board %2)"
msgstr "%1（マザーボード %2）"

#: src/core/messages.cpp
#, kde-format
msgid ""
"This computer is not supported (vendor: %1, model: %2, board: %3).\n"
"Glowzone only runs on: %4"
msgstr ""
"このコンピューターには対応していません（メーカー：%1、モデル：%2、マザーボード：%3）。\n"
"Glowzone の対応機種：%4"

#: src/core/profiles.cpp
#, kde-format
msgid "Could not create the directory %1."
msgstr "ディレクトリ %1 を作成できませんでした。"

#: src/core/profiles.cpp
#, kde-format
msgid "Could not save the profile to %1: %2"
msgstr "プロファイルを %1 に保存できませんでした：%2"

#: src/core/profiles.cpp
#, kde-format
msgid "Could not delete %1."
msgstr "%1 を削除できませんでした。"

#: src/core/profiles.cpp
#, kde-format
msgid "A profile called “%1” already exists."
msgstr "「%1」という名前のプロファイルはすでに存在します。"

#: src/core/settings.cpp
#, kde-format
msgid "Could not remove %1."
msgstr "%1 を削除できませんでした。"

#: src/core/settings.cpp
#, kde-format
