#: src/cli/commands.cpp
#, kde-format
msgid "Fan colour as RRGGBB, for modes that use a colour."
msgstr "ファンの色（RRGGBB 形式、色を使うモードで有効）。"

#: src/cli/commands.cpp
#, kde-format
msgid "Fan effect speed (levels: see below)."
msgstr "ファン効果の速度（レベルは下記を参照）。"

#: src/cli/commands.cpp
#, kde-format
msgid "Brightness of fans or case lights (levels: see below)."
msgstr "ファンまたはケースライトの明るさ（レベルは下記を参照）。"

#: src/cli/commands.cpp
#, kde-format
msgid "Set only one LED of a double fan (positions: see below)."
msgstr "ダブルファンの LED を 1 つだけ設定します（位置は下記を参照）。"

#: src/cli/commands.cpp
#, kde-format
msgid "With cpu-temperature: the temperatures the colours are spread over, e.g. 35-80. Shared by all fans in that mode."
msgstr "cpu-temperature の場合：色を割り当てる温度範囲（例：35-80）。このモードのすべてのファンで共通です。"

#: src/cli/commands.cpp
#, kde-format
msgid "Delete Glowzone's settings, profiles and saved state for this user, then exit."
msgstr "このユーザーの Glowzone の設定、プロファイル、保存された状態を削除して終了します。"

#: src/cli/commands.cpp
#, kde-format
msgid "Run “glowzone --help” for usage."
msgstr "使い方は「glowzone --help」で確認できます。"

#: src/cli/commands.cpp
#, kde-format
msgid "“%1” must be a number from %2 to %3."
msgstr "「%1」には %2 から %3 までの数値を指定してください。"

#: src/cli/commands.cpp
#, kde-format
msgctxt "@info fan effect speed"
msgid "speed %1"
msgstr "速度 %1"

#: src/cli/commands.cpp
#, kde-format
msgctxt "@info"
msgid "brightness %1"
msgstr "明るさ %1"

#: src/cli/commands.cpp
#, kde-format
msgctxt "@info unknown mode value"
msgid "mode %1"
msgstr "モード %1"

#: src/cli/commands.cpp
#, kde-format
msgctxt "@info light mode, brightness"
msgid "%1, brightness %2"
msgstr "%1、明るさ %2"

#: src/cli/commands.cpp
#, kde-format
msgid "Note: LEDs following the CPU temperature only change colour while Glowzone is running (the window, or in the background). Start it with “glowzone” or “glowzone --background”."
msgstr "注意：CPU 温度に連動する LED の色が変わるのは、Glowzone の実行中（ウィンドウまたはバックグラウンド）だけです。「glowzone」または「glowzone --background」で起動してください。"

#: src/cli/commands.cpp
#, kde-format
msgid "“%1” is not a usable range. Give two whole numbers of °C from %2 to %3, at least %4 apart, e.g. 35-80."
msgstr "「%1」は使用できる範囲ではありません。%2〜%3 °C の整数を 2 つ、%4 以上離して指定してください（例：35-80）。"

#: src/cli/commands.cpp
#, kde-format
msgid "Computer: %1"
msgstr "コンピューター：%1"

#: src/cli/commands.cpp
#, kde-format
msgid "Fans (as last set by Glowzone – the controller can’t be read back):"
msgstr "ファン（Glowzone が最後に設定した状態。コントローラーからは読み取れません）："

#: src/cli/commands.cpp
#, kde-format
msgid "unknown (not set by Glowzone yet)"
msgstr "不明（Glowzone でまだ設定されていません）"

#: src/cli/commands.cpp
#, kde-format
msgctxt "@info fan position: description"
msgid "%1: %2"
msgstr "%1：%2"

#: src/cli/commands.cpp
#, kde-format
msgid "the colours follow it"
msgstr "色は温度に連動しています"

#: src/cli/commands.cpp
#, kde-format
msgid "not followed – Glowzone isn’t running"
msgstr "連動していません – Glowzone が実行されていません"

#: src/cli/commands.cpp
#, kde-format
msgid "CPU temperature: %1 °C, colours over %2–%3 °C (%4)"
msgstr "CPU 温度：%1 °C、色の範囲 %2–%3 °C（%4）"

#: src/cli/commands.cpp
#, kde-format
msgid "Lights:"
msgstr "ライト："

#: src/cli/commands.cpp
#, kde-format
msgid "not available: %1"
msgstr "利用不可：%1"

#: src/cli/commands.cpp
#, kde-format
msgctxt "@info"
msgid "all fans detected (layout %1)"
msgstr "すべてのファンを検出（レイアウト %1）"

#: src/cli/commands.cpp
#, kde-format
msgid "Fan detection (BIOS): %1"
msgstr "ファン検出（BIOS）：%1"

#: src/cli/commands.cpp
#, kde-format
msgid "Usage: glowzone fan <fan> <mode> [-c RRGGBB] [-s speed] [-b brightness] [-l position] [-r coolest-hottest]"
msgstr "使い方：glowzone fan <ファン> <モード> [-c RRGGBB] [-s 速度] [-b 明るさ] [-l 位置] [-r 最低-最高]"

#: src/cli/commands.cpp
#, kde-format
msgid "Unknown fan “%1”. Choose one of: %2"
msgstr "不明なファン「%1」です。次から選んでください：%2"

#: src/cli/commands.cpp
#, kde-format
msgid "Unknown fan mode “%1”. Choose one of: %2"
msgstr "不明なファンモード「%1」です。次から選んでください：%2"

#: src/cli/commands.cpp
#, kde-format
msgid "“%1” is not a colour. Use six hex digits, e.g. ff3d9c."
msgstr "「%1」は色ではありません。ff3d9c のように 16 進数 6 桁で指定してください。"

#: src/cli/commands.cpp
#, kde-format
msgid "--range only works with the mode %1."
msgstr "--range はモード %1 でのみ使用できます。"

#: src/cli/commands.cpp
#, kde-format
msgid "--led only works with a single fan that has more than one LED."
msgstr "--led は、LED を複数持つファンを 1 つだけ指定した場合にのみ使えます。"

#: src/cli/commands.cpp
#, kde-format
msgid "Unknown position “%1”. Choose one of: %2"
msgstr "不明な位置「%1」です。次から選んでください：%2"

#: src/cli/commands.cpp
#, kde-format
msgctxt "@item fan (position)"
msgid "%1 (%2)"
msgstr "%1（%2）"

#: src/cli/commands.cpp
#, kde-format
msgid "The fans were changed, but the state could not be saved: %1"
msgstr "ファンは変更されましたが、状態を保存できませんでした：%1"

#: src/cli/commands.cpp
#, kde-format
msgid "Usage: glowzone light <light> [mode] [-b brightness]"
msgstr "使い方：glowzone light <ライト> [モード] [-b 明るさ]"

#: src/cli/commands.cpp
#, kde-format
msgid "Unknown light “%1”. Choose one of: %2"
msgstr "不明なライト「%1」です。次から選んでください：%2"

#: src/cli/commands.cpp
#, kde-format
msgid "Unknown light mode “%1”. Choose one of: %2"
msgstr "不明なライトモード「%1」です。次から選んでください：%2"

#: src/cli/commands.cpp
#, kde-format
msgid "Give a mode, a brightness (-b), or both."
msgstr "モード、明るさ（-b）、またはその両方を指定してください。"

#: src/cli/commands.cpp
#, kde-format
msgid "Fans: all off."
msgstr "ファン：すべてオフ。"

#: src/cli/commands.cpp
#, kde-format
msgid "Fans: %1"
msgstr "ファン：%1"

#: src/cli/commands.cpp
#, kde-format
msgid "Case lights: off."
msgstr "ケースライト：オフ。"

#: src/cli/commands.cpp
#, kde-format
msgid "Case lights: %1"
msgstr "ケースライト：%1"

#: src/cli/commands.cpp
#, kde-format
msgid "Usage: glowzone profile list | apply <name> | save <name> | rename <old> <new> | delete <name>"
msgstr "使い方：glowzone profile list | apply <名前> | save <名前> | rename <旧名> <新名> | delete <名前>"

#: src/cli/commands.cpp
#, kde-format
msgid "No profiles saved yet. Save one with “glowzone profile save <name>”."
msgstr "保存されたプロファイルはまだありません。「glowzone profile save <名前>」で保存できます。"

#: src/cli/commands.cpp src/core/profiles.cpp
#, kde-format
msgid "There is no profile called “%1”."
msgstr "「%1」という名前のプロファイルはありません。"

#: src/cli/commands.cpp
#, kde-format
msgid "Applied profile “%1”."
msgstr "プロファイル「%1」を適用しました。"

#: src/cli/commands.cpp src/core/profiles.cpp src/gui/mainwindow.cpp
#, kde-format
msgid "A profile name must be 1 to %1 characters long."
msgstr "プロファイル名は 1～%1 文字にしてください。"

#: src/cli/commands.cpp
#, kde-format
msgid "Note: Glowzone hasn’t set any fan yet, so the profile contains no fan settings."
msgstr "注意：Glowzone はまだどのファンも設定していないため、このプロファイルにファンの設定は含まれません。"

#: src/cli/commands.cpp
#, kde-format
msgid "Note: the case lights could not be read and are not part of the profile: %1"
msgstr "注意：ケースライトを読み取れなかったため、プロファイルに含まれていません：%1"

#: src/cli/commands.cpp
#, kde-format
msgid "Saved profile “%1”."
msgstr "プロファイル「%1」を保存しました。"

#: src/cli/commands.cpp
#, kde-format
msgid "Deleted profile “%1”."
msgstr "プロファイル「%1」を削除しました。"

#: src/cli/commands.cpp
#, kde-format
msgid "Renamed profile “%1” to “%2”."
msgstr "プロファイル「%1」の名前を「%2」に変更しました。"

#: src/cli/commands.cpp
#, kde-format
msgid "Glowzone is running (the window or in the system tray). Quit it first."
msgstr "Glowzone が実行中です（ウィンドウまたはシステムトレイ）。先に終了してください。"

#: src/cli/commands.cpp
#, kde-format
msgid "Skipping %1: not a Glowzone directory."
msgstr "%1 をスキップします：Glowzone のディレクトリではありません。"

#: src/cli/commands.cpp
#, kde-format
msgid "Removed %1"
msgstr "%1 を削除しました"

#: src/cli/commands.cpp
#, kde-format
msgid "Could not remove %1"
msgstr "%1 を削除できませんでした"

#: src/cli/commands.cpp
#, kde-format
msgid "No Glowzone user data found."
msgstr "Glowzone のユーザーデータは見つかりませんでした。"

#: src/cli/commands.cpp src/cli/main.cpp
#, kde-format
msgid "Lighting control for supported Lenovo desktops: fan LEDs and case lights."
msgstr "対応する Lenovo デスクトップのライティング制御：ファン LED とケースライト。"

#: src/cli/commands.cpp
#, kde-format
msgid "Commands:"
msgstr "コマンド："

#: src/cli/commands.cpp
#, kde-format
msgid "Show the current lighting"
msgstr "現在のライティングを表示"

#: src/cli/commands.cpp
#, kde-format
msgid "Set fan LEDs"
msgstr "ファン LED を設定"

#: src/cli/commands.cpp
#, kde-format
msgid "Set a case light"
msgstr "ケースライトを設定"

#: src/cli/commands.cpp
#, kde-format
msgid "Turn all lighting off"
msgstr "すべてのライティングをオフ"

#: src/cli/commands.cpp
#, kde-format
msgid "List saved profiles (* = applied last)"
msgstr "保存済みプロファイルを一覧表示（* = 最後に適用）"

#: src/cli/commands.cpp
#, kde-format
msgid "Apply a profile"
msgstr "プロファイルを適用"

#: src/cli/commands.cpp
#, kde-format
msgid "Save the current lighting as a profile"
msgstr "現在のライティングをプロファイルとして保存"

#: src/cli/commands.cpp
#, kde-format
msgid "Rename a profile"
msgstr "プロファイルの名前を変更"

#: src/cli/commands.cpp
#, kde-format
msgid "Delete a profile"
msgstr "プロファイルを削除"

#: src/cli/commands.cpp
#, kde-format
msgid "Run glowzone without arguments to open the window, or with --background to start in the system tray."
msgstr "引数なしで glowzone を実行するとウィンドウが開き、--background を付けるとシステムトレイで起動します。"

#: src/cli/commands.cpp
#, kde-format
msgid "This computer (%1):"
msgstr "このコンピューター（%1）："

#: src/cli/commands.cpp
#, kde-format
msgid "Fans:"
msgstr "ファン："

#: src/cli/commands.cpp
#, kde-format
msgid "LEDs (--led):"
msgstr "LED（--led）："

#: src/cli/commands.cpp
#, kde-format
msgid "Fan modes:"
msgstr "ファンモード："

#: src/cli/commands.cpp
#, kde-format
msgid "Fan speed, brightness:"
msgstr "ファンの速度・明るさ："

#: src/cli/commands.cpp
#, kde-format
msgid "Temperature range (--range):"
msgstr "温度範囲（--range）："

#: src/cli/commands.cpp
#, kde-format
msgid "%1 to %2 °C, at least %3 apart (default %4-%5)"
msgstr "%1〜%2 °C、幅は %3 以上（既定値 %4-%5）"

#: src/cli/commands.cpp
#, kde-format
msgid "Light modes:"
msgstr "ライトモード："

#: src/cli/commands.cpp
#, kde-format
msgid "Light brightness:"
msgstr "ライトの明るさ："

#: src/cli/commands.cpp
#, kde-format
msgid "This computer is not supported. Supported models: %1"
msgstr "このコンピューターには対応していません。対応機種：%1"

#: src/cli/commands.cpp
#, kde-format
msgid "status, fan, light, reset or profile"
msgstr "status、fan、light、reset、profile のいずれか"

#: src/cli/commands.cpp
#, kde-format
msgid "Arguments of the command"
msgstr "コマンドの引数"

#: src/cli/commands.cpp
#, kde-format
msgid "Unknown command “%1”."
msgstr "不明なコマンド「%1」です。"

#: src/cli/commands.cpp
#, kde-format
msgid "“status” takes no arguments."
msgstr "「status」に引数は指定できません。"

#: src/cli/commands.cpp
#, kde-format
msgid "“reset” takes no arguments."
msgstr "「reset」に引数は指定できません。"

#: src/cli/main.cpp src/gui/app.cpp
#, kde-format
msgid "Glowzone"
msgstr "Glowzone"

#: src/cli/main.cpp src/gui/aboutdialog.cpp
#, kde-format
