#: src/core/eclights.cpp
#, kde-format
msgid ""
"This is a BIOS detection glitch that can happen after a cold start, when a "
"fan isn’t spinning yet. The fan LEDs usually still work, and your settings "
"are unchanged. A reboot normally clears it."
msgstr ""
"To usterka wykrywania w BIOS-ie, która może się zdarzyć po zimnym starcie, "
"gdy wentylator jeszcze się nie kręci. Diody wentylatorów zwykle nadal "
"działają, a ustawienia pozostają bez zmian. Zwykle pomaga ponowne "
"uruchomienie."

#: src/core/eclights.cpp
#, kde-format
msgctxt "%1 fan names, %2 and %3 layout codes, %4 explanation"
msgid ""
"The BIOS doesn’t detect these fans right now: %1 (fan layout %2, normally "
"%3).\n"
"%4"
msgstr ""
"BIOS nie wykrywa teraz tych wentylatorów: %1 (układ wentylatorów %2, zwykle "
"%3).\n"
"%4"

#: src/core/eclights.cpp
#, kde-format
msgctxt "%1 and %2 layout codes, %3 explanation"
msgid ""
"The BIOS reports an unusual fan layout right now (%1, normally %2); a fan "
"may not be detected.\n"
"%3"
msgstr ""
"BIOS zgłasza teraz nietypowy układ wentylatorów (%1, zwykle %2); któryś "
"wentylator może nie być wykryty.\n"
"%3"

