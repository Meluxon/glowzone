#: src/cli/commands.cpp
#, kde-format
msgid ""
"Usage: glowzone profile list | apply <name> | save <name> | rename <old> "
"<new> | delete <name>"
msgstr ""
"Użycie: glowzone profile list | apply <nazwa> | save <nazwa> | rename "
"<stara> <nowa> | delete <nazwa>"

