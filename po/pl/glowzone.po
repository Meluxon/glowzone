#, kde-format
msgid "“%1” is not a colour. Use six hex digits, e.g. ff3d9c."
msgstr "„%1” nie jest kolorem. Podaj sześć cyfr szesnastkowych, np. ff3d9c."

#: src/cli/commands.cpp
#, kde-format
msgid "--led only works with a single fan that has more than one LED."
msgstr ""
"--led działa tylko z jednym wentylatorem, który ma więcej niż jedną diodę."

