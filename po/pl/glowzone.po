#, kde-format
msgid ""
"Usage: glowzone fan <fan> <mode> [-c RRGGBB] [-s speed] [-b brightness] [-l "
"position]"
msgstr ""
"Użycie: glowzone fan <wentylator> <tryb> [-c RRGGBB] [-s szybkość] [-b "
"jasność] [-l położenie]"

